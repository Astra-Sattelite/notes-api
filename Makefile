.PHONY: build test check fmt tidy update update-patch

build:
	go build ./...

test:
	go test ./...

check:
	go vet ./...
	go test ./...
	go build ./...

fmt:
	go fmt ./...

tidy:
	go mod tidy

update:
	go get -u -t ./...
	go mod tidy
	go test ./...
	go build ./...

update-patch:
	go get -u=patch -t ./...
	go mod tidy
	go test ./...
	go build ./...