{
    "swagger": "2.0",
    "info": {
        "title": "Notes API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/notes": {
            "post": {
                "description": "Creates a note and returns it with id and created_at",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "notes"
                ],
                "summary": "Create a note",
                "parameters": [
                    {
                        "description": "Note data",
                        "name": "note",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.CreateNoteRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/main.Note"
                        }
                    },
                    "400": {
                        "description": "bad json or title is required",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.CreateNoteRequest": {
            "type": "object",
            "properties": {
                "body": {
                    "type": "string",
                    "example": "Hello from Swagger"
                },
                "title": {
                    "type": "string",
                    "example": "First note"
                }
            }
        },
        "main.Note": {
            "type": "object",
            "properties": {
                "body": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                }
            }
        }
    }
}